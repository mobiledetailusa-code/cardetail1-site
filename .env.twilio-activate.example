# Copy to .env.twilio-activate (gitignored). Never commit real values.
# Used by: npm run twilio:activate

# Netlify personal access token (Site configuration → Access tokens)
NETLIFY_AUTH_TOKEN=

# Twilio Console → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio Console → Account → API keys & tokens (Standard key for outbound sends)
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=

# Twilio Console → Messaging → Services (required; do not use TWILIO_FROM)
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio Console → Account → Auth Token (webhook signature validation only)
TWILIO_AUTH_TOKEN=

# Generate locally: openssl rand -hex 32
TWILIO_WORKER_SECRET=

# Optional: add your production sender to the Messaging Service pool
# npm run twilio:activate -- --configure-twilio --confirm-twilio-webhooks --ensure-number +1XXXXXXXXXX
