# Copy to .env locally. Never commit real keys.
# From Prisma Console → cardetail1 → Primary database → Connect
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_KEY"
DIRECT_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# Dual-write BookingRecord (default on when DATABASE_URL is set). Blobs stay authoritative.
# PRISMA_BOOKING_MIRROR=0
# Prisma read fallback after Blob miss (default on when mirror enabled).
# PRISMA_BOOKING_READ=0

# --- Session secrets (never commit real values) ---
# Production must set a dedicated CUSTOMER_SESSION_SECRET (32+ chars), distinct from admin.
# See docs/ops/customer-session-secrets.md
# CUSTOMER_SESSION_SECRET=
# ADMIN_SESSION_SECRET=

# Optional: enables /.netlify/functions/qa-customer-identity-smoke when set (32+).
# Leave unset in Production except during intentional smoke runs.
# CUSTOMER_IDENTITY_SMOKE_SECRET=

# Customer transactional SMS (booking request/confirm/action links).
# Fail-closed: email remains sufficient when any gate/provider value is unset.
# CUSTOMER_TRANSACTIONAL_SMS_ENABLED=false
# TWILIO_OUTBOX_ENABLED=false
# TWILIO_ENABLED=false
# TWILIO_PRODUCTION_SENDS_ENABLED=false
# TWILIO_ALLOWED_BRANCH=master
# TWILIO_ALLOWED_HOST=cardetail1.com
# TWILIO_ACCOUNT_SID=
# TWILIO_API_KEY=
# TWILIO_API_SECRET=
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_STATUS_CALLBACK_URL=https://cardetail1.com/.netlify/functions/twilio-status-callback
# TWILIO_AUTH_TOKEN=
# TWILIO_INBOUND_WEBHOOK_URL=https://cardetail1.com/.netlify/functions/twilio-inbound
# TWILIO_WORKER_SECRET=

# Canonical HTTPS origin for outbound customer email/SMS appointment links.
# Never derived from request Host headers. Falls back to URL / DEPLOY_PRIME_URL.
# PUBLIC_SITE_URL=https://cardetail1.com

# --- Owner Studio Stage 1 (defaults preserve legacy public site) ---
# OWNER_STUDIO_ENABLED=false
# PUBLIC_CONTENT_SOURCE=legacy
# OWNER_STUDIO_ROLE=owner
# OWNER_STUDIO_ADMIN_CAN_PUBLISH=false
# Never point Owner Studio migrate deploy at production. Use an isolated staging DB:
# OWNER_STUDIO_STAGING_DATABASE_URL=
# OWNER_STUDIO_PRODUCTION_DB_USER_HASH=
# Local ops file (gitignored): .env.owner-studio-staging
# npm run owner-studio:staging:assert-db
# npm run owner-studio:staging:migrate
