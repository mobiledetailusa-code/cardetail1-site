# Copy to .env locally. Never commit real keys.
# From Prisma Console → cardetail1 → Primary database → Connect
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_KEY"
DIRECT_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# Dual-write BookingRecord (default on when DATABASE_URL is set). Blobs stay authoritative.
# PRISMA_BOOKING_MIRROR=0
# Prisma read fallback after Blob miss (default on when mirror enabled).
# PRISMA_BOOKING_READ=0

