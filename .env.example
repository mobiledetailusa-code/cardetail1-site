# Copy to .env locally. Never commit real keys.
# From Prisma Console → cardetail1 → Primary database → Connect
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_KEY"
DIRECT_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# Dual-write BookingRecord (default on when DATABASE_URL is set). Blobs stay authoritative.
# PRISMA_BOOKING_MIRROR=0
# Prisma read fallback after Blob miss (default on when mirror enabled).
# PRISMA_BOOKING_READ=0

# --- Session secrets (never commit real values) ---
# Production must set a dedicated CUSTOMER_SESSION_SECRET (32+ chars), distinct from admin.
# See docs/ops/customer-session-secrets.md
# CUSTOMER_SESSION_SECRET=
# ADMIN_SESSION_SECRET=

# Optional: enables /.netlify/functions/qa-customer-identity-smoke when set (32+).
# Leave unset in Production except during intentional smoke runs.
# CUSTOMER_IDENTITY_SMOKE_SECRET=

# Customer transactional SMS (booking request/confirm/action links).
# Requires TWILIO_SID, TWILIO_TOKEN, TWILIO_FROM. Email remains sufficient when unset.
# CUSTOMER_TRANSACTIONAL_SMS_ENABLED=false

