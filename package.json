{
  "name": "cardetail1-site",
  "version": "1.0.0",
  "private": true,
  "description": "Cardetail1 — mobile detailing site (static) + Netlify functions",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:owner-studio": "node --test tests/owner-studio-foundation.test.js",
    "test:owner-studio-staging-guard": "node --test tests/owner-studio-staging-guard.test.js",
    "test:owner-studio-catalog": "node --test tests/owner-studio-catalog-manager.test.js tests/owner-studio-catalog-staging.integration.test.js",
    "owner-studio:import": "node scripts/owner-studio-import.js",
    "owner-studio:staging:assert-db": "node scripts/assert-owner-studio-staging-db.js",
    "owner-studio:staging:assert-schema": "node scripts/assert-owner-studio-staging-db.js --require-schema",
    "owner-studio:staging:migrate": "node scripts/owner-studio-staging-migrate.js",
    "owner-studio:staging:netlify-env": "node scripts/owner-studio-staging-netlify-env.js",
    "owner-studio:staging:seed-catalog": "node scripts/owner-studio-staging-seed-catalog.js",
    "owner-studio:staging:db-diagnostic": "node scripts/owner-studio-staging-db-diagnostic.js --require-schema",
    "owner-studio:staging:catalog-proof": "node scripts/owner-studio-staging-catalog-persistence-proof.js --confirm-staging-proof",
    "owner-studio:staging:catalog-api-proof": "node scripts/owner-studio-staging-catalog-api-proof.js --confirm-staging-proof",
    "audit:pre-deploy": "node scripts/pre-deploy-audit.mjs",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "owner-studio:staging:admin-bootstrap": "node scripts/owner-studio-staging-admin-bootstrap.js --confirm-staging-admin-bootstrap"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.22",
    "@netlify/blobs": "10.7.9",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "prisma": "^7.8.0"
  }
}
