// Cardetail1 — Prisma Postgres (project: cardetail1)
// Ops data still lives in Netlify Blobs for Release A.
// This schema is the foundation for gradual migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Connectivity / deploy smoke check
model PrismaHealth {
  id        String   @id @default(cuid())
  label     String   @default("cardetail1")
  ok        Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Future booking aggregate mirror (JSON payload = Release A booking shape)
model BookingRecord {
  id                    String   @id
  bookingVersion        Int      @default(0)
  quoteVersion          Int      @default(0)
  schemaVersion         Int      @default(1)
  kind                  String   @default("booking")
  jobStatus             String?
  paymentWorkflowStatus String?
  paymentStatus         String?
  phone                 String?
  email                 String?
  preferredDate         String?
  /// Full Release A aggregate / historical blob JSON
  payload               Json
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([phone])
  @@index([email])
  @@index([paymentWorkflowStatus])
  @@index([preferredDate])
  @@index([updatedAt])
}

// =====================================================================
// Phase 2 — transactional foundation (Blob aggregate remains authoritative
// for Release A; these tables are the additive foundation for a future
// cutover, per docs/audit/phase1-delta-audit-2026-07-18.md GATE 1 output.
// Nothing in netlify/functions writes here yet except via netlify/lib/db/*
// repositories, which are not wired into any live endpoint in Phase 2.
// =====================================================================

enum BookingLifecycleStatus {
  draft
  submitted
  confirmed
  in_progress
  completed
  cancelled
}

enum QuoteStatus {
  draft
  approved
  settled
  superseded
}

enum ChangeRequestKind {
  package_change
  addon
  vehicle_add
  vehicle_replace
  address
  reschedule
  cancel
  maintenance
}

enum ChangeRequestStatus {
  pending
  auto_applied
  approved
  rejected
  superseded
}

enum ProviderObjectType {
  payment_intent
  checkout_session
  setup_intent
}

/// creating -> open -> succeeded | failed | canceled | expired; open/creating -> superseded on quote change.
enum PaymentAttemptStatus {
  creating
  open
  requires_action
  succeeded
  failed
  canceled
  expired
  superseded
}

enum LedgerEntryKind {
  settlement
  refund
  adjustment
  fee
}

enum StripeEventStatus {
  received
  processing
  processed
  failed
}

enum RefundRequestStatus {
  creating
  pending_webhook
  requires_action
  succeeded
  failed
  canceled
}

/// Legacy Phase 2 payment/booking join placeholder — NOT the permanent identity root.
/// Production identity authority is CustomerAccount (+ CustomerProfile).
/// Customer remains for gradual Stripe/payment compatibility only; do not treat it
/// as competing with CustomerAccount. No runtime creates this row in Stage 1.
model Customer {
  id               String   @id @default(cuid())
  phone            String?
  email            String?
  firstName        String?
  lastName         String?
  stripeCustomerId String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  bookings Booking[]

  @@index([phone])
  @@index([email])
}

/// Permanent authentication identity and ownership root (Stage 1).
/// Phone/email are NOT primary keys and are NOT globally unique.
enum CustomerAccountStatus {
  active
  disabled
  merged
}

model CustomerAccount {
  id                  String                @id @default(cuid())
  status              CustomerAccountStatus @default(active)
  version             Int                   @default(1)
  stripeCustomerId    String?               @unique
  mergedIntoAccountId String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  profile    CustomerProfile?
  addresses  CustomerAddress[]
  consents   CustomerConsent[]
  bookings   Booking[]
  mergedInto CustomerAccount?  @relation("AccountMerge", fields: [mergedIntoAccountId], references: [id])
  mergedFrom CustomerAccount[] @relation("AccountMerge")

  @@index([status])
  @@index([mergedIntoAccountId])
}

/// Editable contact/profile data — one-to-one with CustomerAccount.
model CustomerProfile {
  id                      String   @id @default(cuid())
  customerAccountId       String   @unique
  firstName               String?
  lastName                String?
  displayName             String?
  email                   String?
  normalizedEmail         String?
  phone                   String?
  normalizedPhone         String?
  preferredContactChannel String?
  timezone                String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  account CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@index([normalizedEmail])
  @@index([normalizedPhone])
}

/// Service addresses owned by an account. Soft-archive via archivedAt — never hard-delete
/// addresses that may be referenced historically.
model CustomerAddress {
  id                String    @id @default(cuid())
  customerAccountId String
  label             String?
  line1             String
  line2             String?
  city              String?
  state             String?
  postalCode        String?
  country           String    @default("US")
  isDefault         Boolean   @default(false)
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  account CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@index([customerAccountId])
  @@index([customerAccountId, isDefault])
}

enum ConsentChannel {
  email_transactional
  sms_transactional
  email_marketing
  sms_marketing
}

enum ConsentStatus {
  granted
  revoked
  pending
}

enum SmsOutboxStatus {
  accepted
  sent
  delivered
  failed
}

/// Current-state consent per account+channel (one row per pair).
model CustomerConsent {
  id                 String         @id @default(cuid())
  customerAccountId  String
  channel            ConsentChannel
  status             ConsentStatus  @default(pending)
  grantedAt          DateTime?
  revokedAt          DateTime?
  source             String?
  consentTextVersion String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  account CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@unique([customerAccountId, channel])
  @@index([customerAccountId])
}

/// Post-commit SMS outbox. Financial transactions never call Twilio directly.
/// Recipient/template data is retained only for delivery and is never logged.
model SmsOutbox {
  id                   String          @id @default(cuid())
  idempotencyKey       String          @unique
  payloadHash          String
  audience             String
  bookingId            String?
  customerAccountId    String?
  toE164               String
  templateKey          String
  templateVersion      String
  templateData         Json
  status               SmsOutboxStatus @default(accepted)
  providerMessageSid   String?         @unique
  providerStatus       String?
  attemptCount         Int             @default(0)
  maxAttempts          Int             @default(5)
  availableAt          DateTime        @default(now())
  leaseToken           String?
  leaseExpiresAt       DateTime?
  lastErrorCode        String?
  acceptedAt           DateTime        @default(now())
  sentAt               DateTime?
  deliveredAt          DateTime?
  failedAt             DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([status, availableAt])
  @@index([customerAccountId, status])
  @@index([bookingId])
}

/// Booking aggregate row. customerAccountId is an identity-linkage field only:
/// backfill-on-login / linkBookingToAccount may set it when null so the account
/// owns the booking. Financial authority (quotes, ledger, payments) is unchanged.
/// Existing non-null links are never overwritten.
model Booking {
  id                String                 @id
  customerId        String?
  customerAccountId String?
  bookingVersion    Int                    @default(0)
  status            BookingLifecycleStatus @default(draft)
  isDraft           Boolean                @default(true)
  archived          Boolean                @default(false)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  customer        Customer?        @relation(fields: [customerId], references: [id])
  customerAccount CustomerAccount? @relation(fields: [customerAccountId], references: [id])
  vehicles        Vehicle[]
  quotes          Quote[]
  changeRequests  ChangeRequest[]
  paymentAttempts PaymentAttempt[]
  refundRequests  RefundRequest[]
  ledgerEntries   LedgerEntry[]
  auditEvents     AuditEvent[]

  @@index([customerId])
  @@index([customerAccountId])
  @@index([status])
}

model Vehicle {
  id         String   @id @default(cuid())
  bookingId  String
  category   String?
  make       String?
  model      String?
  lengthFeet Int?
  label      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  booking    Booking     @relation(fields: [bookingId], references: [id])
  quoteItems QuoteItem[]

  @@index([bookingId])
}

/// Immutable once status = settled (application-layer + trigger enforced; see migration.sql).
model Quote {
  id               String      @id @default(cuid())
  bookingId        String
  quoteVersion     Int
  approvedCents    Int         @default(0)
  currency         String      @default("usd")
  status           QuoteStatus @default(draft)
  adjustmentId     String?     @unique
  adjustmentReason String?
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  booking         Booking          @relation(fields: [bookingId], references: [id])
  items           QuoteItem[]
  paymentAttempts PaymentAttempt[]
  ledgerEntries   LedgerEntry[]

  @@unique([bookingId, quoteVersion])
  @@index([bookingId])
}

model QuoteItem {
  id          String   @id @default(cuid())
  quoteId     String
  vehicleId   String?
  kind        String
  label       String
  amountCents Int
  createdAt   DateTime @default(now())

  quote   Quote    @relation(fields: [quoteId], references: [id])
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])

  @@index([quoteId])
  @@index([vehicleId])
}

model ChangeRequest {
  id                  String              @id @default(cuid())
  bookingId           String
  quoteVersion        Int?
  kind                ChangeRequestKind
  status              ChangeRequestStatus @default(pending)
  payload             Json
  requiresAdminReview Boolean             @default(false)
  decidedAt           DateTime?
  decidedBy           String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([status])
}

/// One active (creating|open|requires_action) obligation per bookingId+quoteVersion —
/// enforced by a partial unique index in migration.sql (not expressible in schema.prisma).
model PaymentAttempt {
  id                         String               @id @default(cuid())
  bookingId                  String
  quoteId                    String?
  quoteVersion               Int
  generation                 Int                  @default(1)
  provider                   String               @default("stripe")
  purpose                    String               @default("customer_balance")
  providerCustomerId         String?
  providerObjectType         ProviderObjectType
  providerObjectId           String?              @unique
  status                     PaymentAttemptStatus @default(creating)
  amountCents                Int
  currency                   String               @default("usd")
  idempotencyKey             String               @unique
  lastProviderEventId        String?
  lastProviderEventCreatedAt DateTime?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  booking        Booking         @relation(fields: [bookingId], references: [id])
  quote          Quote?          @relation(fields: [quoteId], references: [id])
  ledgerEntries  LedgerEntry[]
  refundRequests RefundRequest[]

  @@index([bookingId])
  @@index([quoteVersion])
}

/// Provider refund request state. Money is never debited from the ledger when
/// this row is created; only a signed, invariant-checked refund webhook may
/// append the corresponding LedgerEntry(kind=refund).
model RefundRequest {
  id                         String              @id @default(cuid())
  bookingId                  String
  paymentAttemptId           String
  quoteVersion               Int
  amountCents                Int
  currency                   String              @default("usd")
  reason                     String
  requestedBy                String
  status                     RefundRequestStatus @default(creating)
  requestGroupKey            String
  partIndex                  Int                 @default(0)
  idempotencyKey             String              @unique
  providerRefundId           String?             @unique
  lastProviderEventId        String?
  lastProviderEventCreatedAt DateTime?
  failureCode                String?
  succeededAt                DateTime?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt

  booking        Booking        @relation(fields: [bookingId], references: [id])
  paymentAttempt PaymentAttempt @relation(fields: [paymentAttemptId], references: [id])

  @@unique([requestGroupKey, partIndex])
  @@index([bookingId])
  @@index([paymentAttemptId])
  @@index([requestGroupKey])
  @@index([status])
}

/// Append-only: UPDATE/DELETE are blocked at the database level (see migration.sql trigger).
model LedgerEntry {
  id               String          @id @default(cuid())
  bookingId        String
  quoteId          String?
  paymentAttemptId String?
  kind             LedgerEntryKind
  amountCents      Int
  currency         String          @default("usd")
  quoteVersion     Int
  providerObjectId String?
  providerEventId  String?         @unique
  stripeEventId    String?
  occurredAt       DateTime        @default(now())
  recordedAt       DateTime        @default(now())
  actor            String?

  booking        Booking         @relation(fields: [bookingId], references: [id])
  quote          Quote?          @relation(fields: [quoteId], references: [id])
  paymentAttempt PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id])

  @@index([bookingId])
  @@index([quoteId])
}

/// Idempotent webhook inbox — insert-first-then-process pattern (Phase 3).
model StripeEvent {
  id                String            @id @default(cuid())
  stripeEventId     String            @unique
  type              String
  bookingId         String?
  /// Deliberately minimized provider summary. Never store client_secret,
  /// payment method details, billing details, charges, or the raw event.
  payload           Json
  status            StripeEventStatus @default(received)
  attemptCount      Int               @default(0)
  errorCode         String?
  providerCreatedAt DateTime?
  lastAttemptAt     DateTime?
  processedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([bookingId])
  @@index([type])
  @@index([status])
}

model AuditEvent {
  id        String   @id @default(cuid())
  bookingId String?
  actor     String
  action    String
  detail    Json?
  createdAt DateTime @default(now())

  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([action])
}

// =====================================================================
// Owner Studio Stage 1 — structured CMS + authoritative catalog foundation
// Migration generated but NOT applied to production in Stage 1.
// Requires isolated staging DB before migrate deploy.
// =====================================================================

model OsSite {
  siteId    String   @id
  name      String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings       OsSiteSettings?
  packages       OsPackage[]
  addOns         OsAddOn[]
  vehicleClasses OsVehicleClass[]
  drafts         OsCatalogDraft[]
  revisions      OsCatalogRevision[]
  releases       OsPublishedRelease[]
  currentPointer OsCurrentReleasePointer?
  media          OsMediaAsset[]
  auditLogs      OsAuditLog[]
}

model OsSiteSettings {
  siteId          String   @id
  businessName    String?
  legalEntityName String?
  phoneE164       String?
  publicEmail     String?
  logoMediaId     String?
  announcement    String?
  socialLinksJson Json?
  updatedAt       DateTime @updatedAt

  site OsSite @relation(fields: [siteId], references: [siteId], onDelete: Cascade)
}

model OsPackage {
  siteId       String
  packageId    String
  legacyKey    String?
  category     String
  active       Boolean  @default(true)
  featured     Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  site         OsSite                  @relation(fields: [siteId], references: [siteId], onDelete: Cascade)
  revisions    OsPackageRevision[]
  prices       OsPackagePrice[]
  features     OsPackageFeature[]
  availability OsPackageAvailability[]

  @@id([siteId, packageId])
  @@index([siteId, category])
  @@index([siteId, active])
}

model OsPackageRevision {
  packageRevisionId String   @id @default(cuid())
  siteId            String
  packageId         String
  name              String
  slug              String
  description       String   @default("")
  shortDescription  String   @default("")
  durationMinutes   Int?
  createdAt         DateTime @default(now())
  createdBy         String?

  package OsPackage @relation(fields: [siteId, packageId], references: [siteId, packageId], onDelete: Cascade)

  @@index([siteId, packageId])
}

model OsPackagePrice {
  packagePriceId String   @id @default(cuid())
  siteId         String
  packageId      String
  vehicleClassId String?
  currency       String   @default("usd")
  amountCents    Int
  priceModel     String   @default("flat")
  perFootCents   Int?
  minCents       Int?
  baseCents      Int?
  releaseId      String?
  createdAt      DateTime @default(now())

  package OsPackage @relation(fields: [siteId, packageId], references: [siteId, packageId], onDelete: Cascade)

  @@index([siteId, packageId])
  @@index([siteId, releaseId])
}

model OsPackageFeature {
  id                String  @id @default(cuid())
  siteId            String
  packageId         String
  packageRevisionId String?
  kind              String
  label             String
  sortOrder         Int     @default(0)

  package OsPackage @relation(fields: [siteId, packageId], references: [siteId, packageId], onDelete: Cascade)

  @@index([siteId, packageId])
}

model OsPackageAvailability {
  id        String  @id @default(cuid())
  siteId    String
  packageId String
  channel   String  @default("public")
  active    Boolean @default(true)
  metaJson  Json?

  package OsPackage @relation(fields: [siteId, packageId], references: [siteId, packageId], onDelete: Cascade)

  @@index([siteId, packageId])
}

model OsVehicleClass {
  siteId         String
  vehicleClassId String
  legacyKey      String?
  category       String
  label          String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  site OsSite @relation(fields: [siteId], references: [siteId], onDelete: Cascade)

  @@id([siteId, vehicleClassId])
  @@index([siteId, category])
}

model OsAddOn {
  siteId        String
  addOnId       String
  legacyKey     String?
  active        Boolean  @default(true)
  allowQuantity Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  site          OsSite                 @relation(fields: [siteId], references: [siteId], onDelete: Cascade)
  revisions     OsAddOnRevision[]
  prices        OsAddOnPrice[]
  compatibility OsAddOnCompatibility[]

  @@id([siteId, addOnId])
}

model OsAddOnRevision {
  addOnRevisionId String   @id @default(cuid())
  siteId          String
  addOnId         String
  name            String
  slug            String
  description     String   @default("")
  createdAt       DateTime @default(now())
  createdBy       String?

  addOn OsAddOn @relation(fields: [siteId, addOnId], references: [siteId, addOnId], onDelete: Cascade)

  @@index([siteId, addOnId])
}

model OsAddOnPrice {
  addOnPriceId String   @id @default(cuid())
  siteId       String
  addOnId      String
  category     String?
  currency     String   @default("usd")
  amountCents  Int
  releaseId    String?
  createdAt    DateTime @default(now())

  addOn OsAddOn @relation(fields: [siteId, addOnId], references: [siteId, addOnId], onDelete: Cascade)

  @@index([siteId, addOnId])
}

model OsAddOnCompatibility {
  id        String  @id @default(cuid())
  siteId    String
  addOnId   String
  category  String?
  packageId String?

  addOn OsAddOn @relation(fields: [siteId, addOnId], references: [siteId, addOnId], onDelete: Cascade)

  @@index([siteId, addOnId])
}

model OsMediaAsset {
  mediaId     String    @id
  siteId      String
  path        String
  alt         String    @default("")
  caption     String    @default("")
  contentType String    @default("image/webp")
  published   Boolean   @default(false)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  site OsSite @relation(fields: [siteId], references: [siteId], onDelete: Cascade)

  @@index([siteId, published])
}

model OsCatalogDraft {
  id        String   @id @default(cuid())
  siteId    String
  payload   Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  site OsSite @relation(fields: [siteId], references: [siteId], onDelete: Cascade)

  @@index([siteId])
}

model OsCatalogRevision {
  revisionId String   @id
  siteId     String
  payload    Json
  validation Json?
  createdAt  DateTime @default(now())
  createdBy  String?

  site OsSite @relation(fields: [siteId], references: [siteId], onDelete: Cascade)

  @@index([siteId])
}

model OsPublishedRelease {
  releaseId     String   @id
  siteId        String
  schemaVersion Int      @default(1)
  revisionId    String?
  catalogJson   Json
  contentJson   Json
  manifestJson  Json
  publishedAt   DateTime @default(now())
  publishedBy   String?

  site OsSite @relation(fields: [siteId], references: [siteId], onDelete: Cascade)

  @@index([siteId, publishedAt])
}

/// Atomic current-release pointer — rollback repoints this row.
model OsCurrentReleasePointer {
  siteId    String   @id
  releaseId String
  updatedAt DateTime @updatedAt
  updatedBy String?

  site OsSite @relation(fields: [siteId], references: [siteId], onDelete: Cascade)
}

model OsAuditLog {
  id         String   @id @default(cuid())
  siteId     String
  actor      String
  action     String
  entityType String?
  entityId   String?
  releaseId  String?
  detail     Json?
  createdAt  DateTime @default(now())

  site OsSite @relation(fields: [siteId], references: [siteId], onDelete: Cascade)

  @@index([siteId, createdAt])
  @@index([siteId, action])
}
